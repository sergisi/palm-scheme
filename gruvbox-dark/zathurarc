set notification-error-bg       "#1d2021" # bg
set notification-error-fg       "#cc241d" # bright:red
set notification-warning-bg     "#1d2021" # bg
set notification-warning-fg     "#b16286" # bright:yellow
set notification-bg             "#1d2021" # bg
set notification-fg             "#689d6a" # bright:green

set completion-bg               "#3c3836" # bg2
set completion-fg               "#d5c4a1" # fg
set completion-group-bg         "#282828" # bg1
set completion-group-fg         "#bdae93" # gray
set completion-highlight-bg     "#d65d0e" # bright:blue
set completion-highlight-fg     "#3c3836" # bg2

# Define the color in index mode
set index-bg                    "#3c3836" # bg2
set index-fg                    "#d5c4a1" # fg
set index-active-bg             "#d65d0e" # bright:blue
set index-active-fg             "#3c3836" # bg2

set inputbar-bg                 "#1d2021" # bg
set inputbar-fg                 "#d5c4a1" # fg

set statusbar-bg                "#3c3836" # bg2
set statusbar-fg                "#d5c4a1" # fg

set highlight-color             "#b16286" # bright:yellow
set highlight-active-color      "#af3a03" # bright:orange

set default-bg                  "#1d2021" # bg
set default-fg                  "#d5c4a1" # fg
set render-loading              true
set render-loading-bg           "#1d2021" # bg
set render-loading-fg           "#d5c4a1" # fg

# Recolor book content's color
set recolor-lightcolor          "#1d2021" # bg
set recolor-darkcolor           "#d5c4a1" # fg
set recolor                     "true"
# set recolor-keephue             true      # keep original color
