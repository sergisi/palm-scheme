set notification-error-bg       "#181926" # bg
set notification-error-fg       "#ed8796" # bright:red
set notification-warning-bg     "#181926" # bg
set notification-warning-fg     "#f0c6c6" # bright:yellow
set notification-bg             "#181926" # bg
set notification-fg             "#8aadf4" # bright:green

set completion-bg               "#494d64" # bg2
set completion-fg               "#b8c0e0" # fg
set completion-group-bg         "#363a4f" # bg1
set completion-group-fg         "#a5adcb" # gray
set completion-highlight-bg     "#f5a97f" # bright:blue
set completion-highlight-fg     "#494d64" # bg2

# Define the color in index mode
set index-bg                    "#494d64" # bg2
set index-fg                    "#b8c0e0" # fg
set index-active-bg             "#f5a97f" # bright:blue
set index-active-fg             "#494d64" # bg2

set inputbar-bg                 "#181926" # bg
set inputbar-fg                 "#b8c0e0" # fg

set statusbar-bg                "#494d64" # bg2
set statusbar-fg                "#b8c0e0" # fg

set highlight-color             "#f0c6c6" # bright:yellow
set highlight-active-color      "#af3a03" # bright:orange

set default-bg                  "#181926" # bg
set default-fg                  "#b8c0e0" # fg
set render-loading              true
set render-loading-bg           "#181926" # bg
set render-loading-fg           "#b8c0e0" # fg

# Recolor book content's color
set recolor-lightcolor          "#181926" # bg
set recolor-darkcolor           "#b8c0e0" # fg
set recolor                     "true"
